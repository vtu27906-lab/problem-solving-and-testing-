import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        for (int i = 0; i < n; i++) {
            int salary = sc.nextInt();
            int updatedSalary = salary + (salary * 10 / 100);

            System.out.print(updatedSalary);
            if (i < n - 1) {
                System.out.print(" ");
            }
        }

        sc.close();
    }
}
